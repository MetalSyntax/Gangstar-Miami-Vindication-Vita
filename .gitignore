# macOS metadata
.DS_Store
._*
.Spotlight-V100
.Trashes

# Android APK/ZIP originales y extracción -- nunca commitear el juego (DMCA)
*.apk
*.zip
/gangstarmiamivindication_extract/

# Java decompilado con jadx (derivado, regenerable: jadx -d decompiled/apk_jadx "Gangstar-Miami-Vindication-HD.apk")
/decompiled/apk_jadx/

# Pseudo-C decompilado del/los .so (derivado, regenerable con devrvk/so-decompiler)
/decompiled/*/ghidra/

# Desensamblado completo del/los .so (derivado del binario propietario, regenerable, y pesa
# decenas de MB -- mismo motivo DMCA que el resto de decompiled/)
/decompiled/disasm/

# Build artifact regenerado por el toolkit en cada build, con rutas absolutas de la máquina local
/compile_commands.json

# Librerías .so propietarias del juego original
lib/*.so
lib/**/*.so
gangstarmiamivindication_extract/lib/

# Assets del juego montados para pruebas
ux0_data/
assets/

